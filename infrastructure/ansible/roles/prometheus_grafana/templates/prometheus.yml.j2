global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ["{{ hostvars[host].ansible_host }}:{{ node_exporter_port }}"]
        labels:
          instance: "{{ host }}"
{% endfor %}
